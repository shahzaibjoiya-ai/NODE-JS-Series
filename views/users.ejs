<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Users</title>
</head>
<body>
    <h1>Users</h1>
    <ul>
        <% users.forEach(user => { %>
            <li><%= user.name %> - <%= user.age %> years old</li>
        <% }); %>
    </ul>
    <% if (isLogin) { %>
        <p>Welcome, user!</p>
    <% } else { %>
        <p>Please log in.</p>
    <% } %>
</body>
</html>